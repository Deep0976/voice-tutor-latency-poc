# ---------------------------------------------------------------------------
# Voice Tutor POC — configuration template
# ---------------------------------------------------------------------------
# HOW TO USE: copy this file to a new file named ".env" (same folder), then
# paste your real keys after the "=" signs. Never commit the real .env file.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------

# REQUIRED — Sarvam AI key (speech-to-text, the tutor's "ears").
# Get it at: https://dashboard.sarvam.ai  ->  API Keys
SARVAM_API_KEY=

# REQUIRED — OpenAI key (GPT-4o, the tutor's "brain").
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# REQUIRED — ElevenLabs key (text-to-speech, the tutor's "voice").
# Get it at: https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# REQUIRED — the ElevenLabs voice you want. Paste the Voice ID (NOT the name).
# Find it at https://elevenlabs.io/app/voices -> pick a voice -> copy its Voice ID.
ELEVENLABS_VOICE_ID=

# REQUIRED FOR HOSTING (Daily cloud transport, so friends can connect from anywhere).
# Free account at https://dashboard.daily.co -> Developers -> API keys.
# Not needed for local self-hosted WebRTC testing.
DAILY_API_KEY=

# OPTIONAL — starting language the tutor listens/speaks in.
#   te = Telugu   ta = Tamil   hi = Hindi   kn = Kannada
# You can also just say "talk in Hindi" mid-call to switch live.
TUTOR_LANGUAGE=te

# OPTIONAL — overrides you usually don't need to touch.
# LLM_MODEL=gpt-4o
# ELEVENLABS_MODEL=eleven_turbo_v2_5
